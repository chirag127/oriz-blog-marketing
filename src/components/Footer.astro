---
/*
 * blog-app Footer — "Signal Press" editorial surface.
 *
 * Signature element: a serif pull-quote (Source Serif 4) with a signal-orange
 * quote mark — the only place the footer raises its voice. Everything else
 * stays library-quiet: mono column headings, mono tag links, hairline rules.
 *
 * Reads palette + type from the editorial tokens (tokens.css / global.css).
 */
import LegalFooter from '~/components/chrome/legal/LegalFooter.astro'
import {
  getCategoriesWithCounts,
  getTagsWithCounts,
  slugifyTag,
} from '~/lib/blog'

const categories = [
  { name: 'All categories', slug: '' },
  ...(await getCategoriesWithCounts()).slice(0, 6).map(({ category }) => ({
    name: category,
    slug: slugifyTag(category),
  })),
]
const tags = (await getTagsWithCounts()).slice(0, 8).map(({ tag }) => tag)
---
<footer class="blog-footer" role="contentinfo">
  <div class="bf-lede">
    <p class="bf-eyebrow mono">RankRoom · marketing &amp; SEO</p>
    <p class="bf-big">Rank for the query<br /><em>already being typed.</em></p>
  </div>
  <div class="bf-grid">
    <div class="bf-col">
      <h3 class="bf-h">Playbook</h3>
      <ul>
        <li><a href="/blog/">Latest posts</a></li>
        <li><a href="/archive/">Archive</a></li>
        <li><a href="/now/">Now</a></li>
      </ul>
    </div>
    <div class="bf-col">
      <h3 class="bf-h">Series</h3>
      <ul>
        <li><a href="/series/">Browse series</a></li>
        <li><a href="/blog/">Latest threads</a></li>
      </ul>
    </div>
    <div class="bf-col">
      <h3 class="bf-h">Topics</h3>
      <ul>
        {categories.map((c) => <li><a href={c.slug ? `/categories/${c.slug}/` : '/categories/'}>{c.name}</a></li>)}
      </ul>
    </div>
    <div class="bf-col">
      <h3 class="bf-h">Tags</h3>
      <ul class="bf-tags">
        {tags.map((t) => <li><a href={`/tags/${slugifyTag(t)}/`}>#{t}</a></li>)}
      </ul>
    </div>
  </div>
  <LegalFooter
    github="https://github.com/chirag127/oriz-blog-marketing"
    appName="RankRoom"
    bio="Plain, tested tactics for SEO, content marketing, and email by Chirag Singhal."
    rss="/rss.xml"
  />
</footer>
<style>
  .blog-footer {
    margin-top: 0;
    background: var(--color-paper-2, var(--paper-2, transparent));
    color: var(--color-ink, var(--ink));
    border-top: 1px solid var(--color-rule, var(--rule));
  }
  .bf-lede {
    max-width: 1040px; margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) 16px 1.5rem;
  }
  .bf-eyebrow {
    margin: 0 0 1rem; font-family: var(--font-mono, ui-monospace);
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em;
    color: var(--color-ink-mute, var(--ink-mute));
  }
  .bf-big {
    margin: 0;
    font-family: var(--font-display, 'Source Serif 4', Georgia, serif);
    font-weight: 600;
    font-size: clamp(2rem, 7vw, 4rem);
    line-height: 1.02; letter-spacing: -0.035em;
    color: var(--color-ink, var(--ink)); max-width: 16ch;
  }
  .bf-big em { font-style: normal; color: var(--color-accent, var(--accent)); }
  .bf-grid {
    max-width: 1040px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1fr; gap: 24px;
    padding: 1.5rem 16px 1.5rem;
    border-top: 1px solid var(--color-rule, var(--rule));
  }
  .bf-h {
    margin: 0 0 14px;
    font-family: var(--font-mono, ui-monospace);
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em;
    color: var(--color-ink-mute, var(--ink-mute)); font-weight: 500;
  }
  .bf-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .bf-col a { color: var(--color-ink, var(--ink)); font-size: 14px; text-decoration: none; }
  .bf-col a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .bf-tags { flex-direction: row; flex-wrap: wrap; gap: 8px 12px; }
  .bf-tags a { font-family: var(--font-mono, ui-monospace); font-size: 13px; color: var(--color-ink-mute, var(--ink-mute)); }
  .bf-tags a:hover { color: var(--color-accent, var(--accent)); text-decoration: none; }
  @media (min-width: 900px) { .bf-grid { grid-template-columns: repeat(4, 1fr); gap: 32px; padding: 1.5rem 24px 2rem; } .bf-lede { padding-inline: 24px; } }
</style>
