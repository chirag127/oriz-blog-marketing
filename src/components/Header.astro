---
import HeaderControls from '~/components/HeaderControls.tsx'
import MultiSearch from '~/components/MultiSearch.tsx'
import StatusBanner from '~/components/StatusBanner.astro'
/*
 * Header — floating pill nav ("RankRoom" landing shell, 2026-08-12).
 *
 *        ╭───────────────────────────────────────────────────────────╮
 *        │  #1 RankRoom     PLAYBOOK · SERIES · TOPICS · ABOUT   ⌘K → │
 *        ╰───────────────────────────────────────────────────────────╯
 *
 * NOT the sibling full-width top bar. A centered floating capsule that sits
 * over the hero and SHRINKS + tightens on scroll (data-scrolled toggled by a
 * tiny inline observer). Conversion-page energy: the brand mark doubles as the
 * top-rank badge, the nav is compact, and a single mint CTA anchors the right.
 */
import Wordmark from '~/components/Wordmark.astro'
---

<StatusBanner />
<div class="pill-rail" transition:persist="site-header">
  <header class="pill" data-scrolled="false">
    <a class="pill-brand" href="/" aria-label="RankRoom home">
      <Wordmark subtitle={undefined} size={18} href={null} />
    </a>
    <nav class="pill-nav" aria-label="Primary">
      <a href="/blog/" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>Playbook</a>
      <a href="/series/" aria-current={Astro.url.pathname.startsWith('/series') ? 'page' : undefined}>Series</a>
      <a href="/categories/" aria-current={Astro.url.pathname.startsWith('/categories') ? 'page' : undefined}>Topics</a>
      <a href="/about/" aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined}>About</a>
    </nav>
    <div class="pill-actions">
      <div class="pill-multisearch"><MultiSearch client:idle /></div>
      <div class="pill-controls"><HeaderControls client:idle /></div>
      <a class="pill-cta" href="/blog/">Start ranking <span aria-hidden="true">→</span></a>
    </div>
  </header>
</div>

<script is:inline>
  {`(() => {
    const pill = document.querySelector('.pill');
    if (!pill) return;
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        pill.dataset.scrolled = window.scrollY > 24 ? 'true' : 'false';
        ticking = false;
      });
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:after-swap', () => {
      pill.dataset.scrolled = window.scrollY > 24 ? 'true' : 'false';
    });
  })()`}
</script>

<style>
  .pill-rail {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: clamp(0.6rem, 1.6vw, 1rem) 1rem;
    pointer-events: none;
  }
  .pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2rem);
    width: min(1040px, 100%);
    padding: 0.7rem 0.8rem 0.7rem 1.1rem;
    background: color-mix(in oklab, var(--paper-2) 82%, transparent);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    box-shadow: 0 10px 30px -18px color-mix(in oklab, #000 70%, transparent),
      inset 0 0 0 1px color-mix(in oklab, var(--accent) 8%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    transition:
      padding var(--dur-base, 200ms) var(--ease-out),
      width var(--dur-base, 200ms) var(--ease-out),
      background var(--dur-base, 200ms) var(--ease-out),
      box-shadow var(--dur-base, 200ms) var(--ease-out);
  }
  .pill[data-scrolled='true'] {
    width: min(880px, 100%);
    padding-block: 0.5rem;
    background: color-mix(in oklab, var(--paper-2) 94%, transparent);
    box-shadow: 0 14px 34px -16px color-mix(in oklab, #000 80%, transparent);
  }

  .pill-brand { display: inline-flex; align-items: center; text-decoration: none; flex: 0 0 auto; }

  .pill-nav {
    display: none;
    gap: clamp(0.9rem, 1.8vw, 1.5rem);
    margin-inline: auto;
    font-family: var(--font-utility, var(--font-mono));
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .pill-nav a {
    position: relative;
    color: var(--ink-mute);
    text-decoration: none;
    padding-block: 0.2rem;
    transition: color var(--dur-fast, 120ms) ease;
  }
  .pill-nav a:hover { color: var(--ink); }
  .pill-nav a[aria-current='page'] { color: var(--accent); }
  .pill-nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -3px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    transform: translateX(-50%);
  }

  .pill-actions { display: inline-flex; align-items: center; gap: 0.5rem; margin-left: auto; }
  .pill-multisearch, .pill-controls { display: inline-flex; align-items: center; }

  .pill-cta {
    display: none;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--color-accent-fg);
    font-family: var(--font-utility, var(--font-mono));
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: transform var(--dur-fast, 120ms) ease, filter var(--dur-fast, 120ms) ease;
  }
  .pill-cta:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .pill-cta:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .pill-cta span { transition: transform var(--dur-fast, 120ms) ease; }
  .pill-cta:hover span { transform: translateX(3px); }

  @media (min-width: 768px) {
    .pill-nav { display: inline-flex; align-items: center; }
    .pill-cta { display: inline-flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pill, .pill-cta, .pill-cta span { transition: none; }
  }
</style>
