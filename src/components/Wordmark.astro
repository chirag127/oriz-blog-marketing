---
/*
 * Wordmark — "RankRoom" set in Space Grotesk, with a signature SERP rank badge:
 * a mint `#1` chip (the coveted top organic position) sits before the name.
 * The badge IS the brand mark — the whole promise of the blog compressed to a
 * glyph. Distinct from the sister oriz-blog proofreader z-strike.
 */

interface Props {
  /** Sub-section name — rendered after a `·` separator. */
  subtitle?: string
  /** Display size in CSS pixels. */
  size?: number
  /** Wrap the mark in an <a href="/"> — defaults to '/' when subtitle is set. */
  href?: string | null
  /** Render as <h1> (the masthead) rather than <div>. */
  asHeading?: boolean
}

const { subtitle, size = 96, href = null, asHeading = false } = Astro.props
const Tag = asHeading ? 'h1' : ('div' as const)
---

{
  href ? (
    <a class="wordmark-link" href={href} aria-label={subtitle ? `RankRoom / ${subtitle}` : 'RankRoom'}>
      <Tag class="wordmark" style={`--wm-size: ${size}px;`}>
        <span class="wordmark-badge" aria-hidden="true">#1</span>
        <span class="wordmark-name">RankRoom</span>
        {subtitle && (
          <>
            <span class="wordmark-sep" aria-hidden="true">·</span>
            <span class="wordmark-sub">{subtitle}</span>
          </>
        )}
      </Tag>
    </a>
  ) : (
    <Tag class="wordmark" style={`--wm-size: ${size}px;`}>
      <span class="wordmark-badge" aria-hidden="true">#1</span>
      <span class="wordmark-name">RankRoom</span>
      {subtitle && (
        <>
          <span class="wordmark-sep" aria-hidden="true">·</span>
          <span class="wordmark-sub">{subtitle}</span>
        </>
      )}
    </Tag>
  )
}

<style>
  .wordmark-link {
    display: inline-block;
    color: inherit;
    text-decoration: none;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.32em;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--wm-size, 96px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .wordmark-badge {
    font-family: var(--font-mono);
    font-size: 0.44em;
    font-weight: 500;
    line-height: 1;
    color: var(--color-accent-fg);
    background: var(--accent);
    padding: 0.2em 0.34em;
    border-radius: 0.28em;
    letter-spacing: 0;
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--accent) 40%, transparent);
  }
  .wordmark-name {
    font-weight: 600;
  }
  .wordmark-sep {
    margin-inline: 0.08em;
    color: var(--ink-mute);
    font-weight: 400;
  }
  .wordmark-sub {
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.5em;
    letter-spacing: 0.02em;
    text-transform: lowercase;
  }
</style>
