---
import SeriesSpine from '~/components/SeriesSpine.astro'
/**
 * /  — RankRoom homepage ("SERP native" front page).
 *
 * The hero is a live search-engine result page. A query sits in a search box
 * with a blinking mint cursor; below it, the site's thesis is rendered as the
 * #1 organic result. Recent posts render as ranked SERP result rows: mono
 * position number, blue-style linked title, mint URL breadcrumb, snippet.
 *
 * The SERP row is the site's signature primitive — the niche's own visual
 * vernacular, not a card grid or a newspaper column.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getCategoriesWithCounts,
  getPostsInSeries,
  getPublishedPosts,
  getSeriesWithCounts,
  postVertical,
  readingTimeFor,
  slugifyTag,
  verticalFor,
  verticalLabel,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const lead = allPosts[0]
const recentPosts = allPosts.slice(1, 8)

const seriesAll = await getSeriesWithCounts()
type InProgress = {
  name: string
  slug: string
  total: number
  published: number
  current: number
  latest: Date
  parts: Awaited<ReturnType<typeof getPostsInSeries>>
}
const inProgress: InProgress[] = []
for (const { series, count } of seriesAll.slice(0, 4)) {
  const parts = await getPostsInSeries(series)
  const latest = parts.reduce(
    (max, p) => (p.data.pubDate > max ? p.data.pubDate : max),
    parts[0].data.pubDate,
  )
  const explicitMax = parts.reduce((mx, p) => {
    const v = typeof p.data.part === 'number' ? p.data.part : Number(p.data.part)
    return Number.isFinite(v) ? Math.max(mx, v) : mx
  }, 0)
  const total = Math.max(count, explicitMax, count + 1)
  inProgress.push({
    name: series,
    slug: slugifyTag(series),
    total,
    published: count,
    current: count,
    latest,
    parts,
  })
}
inProgress.sort((a, b) => b.latest.valueOf() - a.latest.valueOf())

const cats = await getCategoriesWithCounts()

// SERP breadcrumb host — the "green URL" line under each result title.
const host = 'marketing-blog.oriz.in'

const leadVertical = lead ? postVertical(lead) : 'personal'
const leadRt = lead ? (lead.data.readingTime ?? readingTimeFor(lead)) : ''

function ago(date: Date): string {
  const days = Math.floor((Date.now() - date.valueOf()) / 86_400_000)
  if (days < 1) return 'today'
  if (days === 1) return '1d ago'
  if (days < 30) return `${days}d ago`
  const months = Math.floor(days / 30)
  if (months === 1) return '1mo ago'
  if (months < 12) return `${months}mo ago`
  const years = Math.floor(days / 365)
  return years === 1 ? '1y ago' : `${years}y ago`
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}
---

<BaseLayout
  title="RankRoom — marketing & SEO that compounds"
  description={SITE_CONFIG.description}
  jsonLd={jsonLd}
  hideSidebar
>
  <div class="container-page">
    {/* Hero — a live SERP. Query in a search box, thesis as the #1 result. */}
    <section class="serp-hero" aria-label="Search results">
      <div class="searchbox" role="img" aria-label='Search query: how to actually rank in 2026'>
        <svg class="searchbox-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path>
        </svg>
        <span class="searchbox-q">how to actually rank in 2026</span>
        <span class="searchbox-caret" aria-hidden="true"></span>
      </div>
      <p class="serp-stats mono">About <span class="serp-count">{allPosts.length}</span> results · sorted by what actually works</p>

      {lead && (
        <a class="serp-lead" href={`/blog/${lead.id}`} data-vertical={leadVertical}>
          <span class="serp-url mono"><span class="serp-dot" aria-hidden="true"></span>{host} › {verticalLabel(leadVertical).toLowerCase()}</span>
          <h1 class="serp-thesis">Marketing that compounds — not marketing that just spends.</h1>
          <p class="serp-lead-title">{lead.data.title}</p>
          <p class="serp-lead-snippet">{lead.data.description}</p>
          <span class="serp-lead-meta mono">
            <time datetime={lead.data.pubDate.toISOString()}>{lead.data.pubDate.toISOString().slice(0, 10)}</time>
            <span aria-hidden="true">·</span><span>{leadRt}</span>
            <span aria-hidden="true">·</span><span class="serp-featured">Featured snippet</span>
          </span>
        </a>
      )}
    </section>

    <hr class="hairline" />

    {/* Stratum 1 — IN PROGRESS. */}
    {inProgress.length > 0 && (
      <section class="stratum stratum-progress" aria-labelledby="s-progress">
        <h2 id="s-progress" class="stratum-h mono">// running series</h2>
        <ul class="progress-list">
          {inProgress.map((s) => (
            <li class="progress-row">
              <a class="progress-link" href={`/series/${s.slug}/`}>
                <span class="progress-name">{s.name}</span>
                <span class="progress-meta mono">part {s.published} of {s.total}</span>
                <span class="progress-spine-mount">
                  <SeriesSpine
                    total={s.total}
                    published={s.published}
                    current={s.current}
                    size="md"
                  />
                </span>
                <span class="progress-ago mono">{ago(s.latest)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <hr class="hairline" />

    {/* Stratum 2 — RECENT, as ranked SERP result rows. */}
    <section class="stratum stratum-recent" aria-labelledby="s-recent">
      <h2 id="s-recent" class="stratum-h mono">// latest results</h2>
      <ol class="serp-list">
        {recentPosts.map((p, i) => (
          <li class="serp-row" data-vertical={postVertical(p)}>
            <a class="serp-row-link" href={`/blog/${p.id}`}>
              <span class="serp-rank mono" aria-hidden="true">#{i + 2}</span>
              <span class="serp-body">
                <span class="serp-row-url mono"><span class="serp-dot" aria-hidden="true"></span>{host} › {verticalLabel(postVertical(p)).toLowerCase()}</span>
                <span class="serp-row-title">{p.data.title}</span>
                <span class="serp-row-snippet">{p.data.description}</span>
                <span class="serp-row-meta mono">
                  <time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toISOString().slice(0, 10)}</time>
                  <span aria-hidden="true">·</span><span>{p.data.readingTime ?? readingTimeFor(p)}</span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ol>
      <p class="all-link">
        <a href="/archive/">see all {allPosts.length} results in the archive →</a>
      </p>
    </section>

    <hr class="hairline" />

    {/* Stratum 3 — TOPICS (query-refinement chips). */}
    {cats.length > 0 && (
      <section class="stratum stratum-cats" aria-labelledby="s-cats">
        <h2 id="s-cats" class="stratum-h mono">// refine by topic</h2>
        <p class="cats-row">
          {cats.map((c) => (
            <a href={`/categories/${slugifyTag(c.category)}/`} class="cats-chip" data-vertical={verticalFor(c.category)}>
              <span class="cats-name">{c.category}</span>
              <span class="cats-count mono">{c.count}</span>
            </a>
          ))}
        </p>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .container-page {
    max-width: 920px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2rem);
  }

  /* ── SERP hero ─────────────────────────────────────────────────────── */

  .serp-hero {
    padding-block: clamp(2rem, 6vw, 3.5rem) 1.75rem;
  }
  .searchbox {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 560px;
    padding: 0.85rem 1.15rem;
    background: var(--paper-2);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    box-shadow: 0 1px 0 color-mix(in oklab, var(--accent) 12%, transparent);
    color: var(--ink);
  }
  .searchbox-icon {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--ink-mute);
    flex: 0 0 auto;
  }
  .searchbox-q {
    font-family: var(--font-mono);
    font-size: clamp(0.95rem, 2.4vw, 1.15rem);
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .searchbox-caret {
    width: 2px;
    height: 1.25em;
    background: var(--accent);
    margin-left: -0.35rem;
    animation: caret-blink 1.05s steps(1) infinite;
  }
  @keyframes caret-blink {
    0%, 50% { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }

  .serp-stats {
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--ink-mute);
    margin: 0.9rem 0 1.75rem;
  }
  .serp-count { color: var(--ink); font-weight: 500; }

  .serp-url, .serp-row-url {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 12px;
    letter-spacing: 0.01em;
    color: var(--serp-url);
  }
  .serp-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--serp-url);
    flex: 0 0 auto;
  }

  .serp-lead {
    --v: var(--v-personal);
    display: grid;
    gap: 0.55rem;
    color: var(--ink);
    text-decoration: none;
    border-left: 3px solid var(--accent);
    padding: 0.25rem 0 0.25rem 1.15rem;
  }
  .serp-lead[data-vertical='dev'] { --v: var(--v-dev); }
  .serp-lead[data-vertical='finance'] { --v: var(--v-finance); }
  .serp-lead[data-vertical='culture'] { --v: var(--v-culture); }
  .serp-lead[data-vertical='health'] { --v: var(--v-health); }
  .serp-thesis {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0.15rem 0 0.35rem;
    max-width: 18ch;
    color: var(--ink);
  }
  .serp-lead-title {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--serp-link);
    margin: 0;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
  }
  .serp-lead:hover .serp-lead-title { text-decoration-color: var(--serp-link); }
  .serp-lead-snippet {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink-mute);
    margin: 0;
    max-width: 62ch;
  }
  .serp-lead-meta {
    display: inline-flex; flex-wrap: wrap; gap: 0.45rem;
    font-size: 11px; letter-spacing: 0.03em; color: var(--ink-mute);
  }
  .serp-featured { color: var(--accent); }

  /* ── Strata ─────────────────────────────────────────────────────────── */

  .stratum { padding-block: 1.75rem; }
  .stratum-h {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--accent);
    font-weight: 500;
    margin: 0 0 1.25rem;
  }

  /* ── In progress ──────────────────────────────────────────────────── */

  .progress-list {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 0.625rem;
  }
  .progress-row { padding: 0; }
  .progress-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto auto;
    gap: 1rem;
    align-items: baseline;
    color: var(--ink);
    text-decoration: none;
    padding-block: 0.5rem;
  }
  .progress-link:hover { color: var(--accent); }
  .progress-link:hover .progress-meta,
  .progress-link:hover .progress-ago { color: var(--accent); }
  .progress-name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .progress-meta, .progress-ago {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-mute);
  }
  .progress-spine-mount { display: inline-flex; }

  @media (max-width: 640px) {
    .progress-link {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'name      ago'
        'meta      meta'
        'spine     spine';
      row-gap: 0.25rem;
    }
    .progress-name { grid-area: name; }
    .progress-meta { grid-area: meta; }
    .progress-spine-mount { grid-area: spine; }
    .progress-ago { grid-area: ago; text-align: right; }
  }

  /* ── SERP result rows (signature) ───────────────────────────────────── */

  .serp-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .serp-row {
    --v: var(--v-personal);
    border-radius: var(--radius-card);
    transition: background var(--dur-fast, 120ms) ease;
  }
  .serp-row[data-vertical='dev'] { --v: var(--v-dev); }
  .serp-row[data-vertical='finance'] { --v: var(--v-finance); }
  .serp-row[data-vertical='culture'] { --v: var(--v-culture); }
  .serp-row[data-vertical='health'] { --v: var(--v-health); }
  .serp-row:hover { background: color-mix(in oklab, var(--paper-2) 75%, transparent); }

  .serp-row-link {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.5rem 1rem;
    align-items: start;
    color: var(--ink);
    text-decoration: none;
    padding: 0.95rem 1rem;
  }
  .serp-rank {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-mute);
    padding-top: 1.15rem;
    text-align: right;
    border-right: 2px solid var(--v);
    padding-right: 0.65rem;
    min-height: 2.2em;
  }
  .serp-body { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .serp-row-title {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--serp-link);
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
  }
  .serp-row-link:hover .serp-row-title { text-decoration-color: var(--serp-link); }
  .serp-row-snippet {
    font-size: 0.9375rem;
    color: var(--ink-mute);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .serp-row-meta {
    display: inline-flex; gap: 0.4rem;
    font-size: 11px; letter-spacing: 0.03em; color: var(--ink-mute);
  }

  @media (max-width: 480px) {
    .serp-row-link { grid-template-columns: 1.9rem minmax(0, 1fr); gap: 0.35rem 0.65rem; padding-inline: 0.5rem; }
    .serp-rank { padding-right: 0.4rem; }
  }

  .all-link {
    margin: 1.25rem 0 0;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .all-link a {
    color: var(--ink-mute);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--rule);
  }
  .all-link a:hover { color: var(--accent); text-decoration-color: var(--accent); }

  /* ── Topics (query-refinement chips) ────────────────────────────────── */

  .cats-row {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cats-chip {
    --v: var(--v-personal);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-2);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur-fast, 120ms) ease, color var(--dur-fast, 120ms) ease;
  }
  .cats-chip[data-vertical='dev'] { --v: var(--v-dev); }
  .cats-chip[data-vertical='finance'] { --v: var(--v-finance); }
  .cats-chip[data-vertical='culture'] { --v: var(--v-culture); }
  .cats-chip[data-vertical='health'] { --v: var(--v-health); }
  .cats-chip:hover { border-color: var(--v); color: var(--v); }
  .cats-name {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.005em;
  }
  .cats-count {
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  @media (prefers-reduced-motion: reduce) {
    .searchbox-caret { animation: none; opacity: 1; }
  }
</style>

