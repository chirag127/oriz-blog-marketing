---
import SeriesSpine from '~/components/SeriesSpine.astro'
/**
 * /  — RankRoom landing page (BOLD LANDING-PAGE archetype, 2026-08-12).
 *
 * NOT a post list first. A sectioned, scroll-told conversion page:
 *   1. HERO      — giant display thesis + a live query line (the niche's mark)
 *   2. PROOF     — a stat band pulled from the corpus (results / series / topics)
 *   3. FEATURE   — the lead post as a full-width feature block
 *   4. PLAYBOOK  — latest posts as a bold ranked stack (SERP row = signature)
 *   5. SERIES    — running multi-part playbooks with progress spines
 *   6. TOPICS    — refine-by-topic chips
 *   7. CTA       — closing conversion band
 *
 * The SERP-styled ranked row stays as the signature primitive, but it now
 * lives inside a landing structure, not as the whole page. Deliberately does
 * NOT resemble the top-nav card-grid siblings.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getCategoriesWithCounts,
  getPostsInSeries,
  getPublishedPosts,
  getSeriesWithCounts,
  postVertical,
  readingTimeFor,
  slugifyTag,
  verticalFor,
  verticalLabel,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const lead = allPosts[0]
const recentPosts = allPosts.slice(1, 7)

const seriesAll = await getSeriesWithCounts()
type InProgress = {
  name: string
  slug: string
  total: number
  published: number
  current: number
  latest: Date
  parts: Awaited<ReturnType<typeof getPostsInSeries>>
}
const inProgress: InProgress[] = []
for (const { series, count } of seriesAll.slice(0, 4)) {
  const parts = await getPostsInSeries(series)
  const latest = parts.reduce(
    (max, p) => (p.data.pubDate > max ? p.data.pubDate : max),
    parts[0].data.pubDate,
  )
  const explicitMax = parts.reduce((mx, p) => {
    const v = typeof p.data.part === 'number' ? p.data.part : Number(p.data.part)
    return Number.isFinite(v) ? Math.max(mx, v) : mx
  }, 0)
  const total = Math.max(count, explicitMax, count + 1)
  inProgress.push({
    name: series,
    slug: slugifyTag(series),
    total,
    published: count,
    current: count,
    latest,
    parts,
  })
}
inProgress.sort((a, b) => b.latest.valueOf() - a.latest.valueOf())

const cats = await getCategoriesWithCounts()

const host = 'marketing-blog.oriz.in'
const leadVertical = lead ? postVertical(lead) : 'personal'
const leadRt = lead ? (lead.data.readingTime ?? readingTimeFor(lead)) : ''

function ago(date: Date): string {
  const days = Math.floor((Date.now() - date.valueOf()) / 86_400_000)
  if (days < 1) return 'today'
  if (days === 1) return '1d ago'
  if (days < 30) return `${days}d ago`
  const months = Math.floor(days / 30)
  if (months === 1) return '1mo ago'
  if (months < 12) return `${months}mo ago`
  const years = Math.floor(days / 365)
  return years === 1 ? '1y ago' : `${years}y ago`
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}
---

<BaseLayout
  title="RankRoom — marketing & SEO that compounds"
  description={SITE_CONFIG.description}
  jsonLd={jsonLd}
  hideSidebar
>
  {/* ── 1 · HERO — giant type thesis over a live query line ─────────────── */}
  <section class="hero" aria-labelledby="hero-h">
    <div class="hero-inner">
      <p class="hero-eyebrow mono">SEO · Content · Email · Analytics</p>
      <h1 id="hero-h" class="hero-h">
        Marketing that <em>compounds</em>—<br />not marketing that just spends.
      </h1>
      <p class="hero-sub">
        Plain, tested tactics from someone who ships. No agency retainer, no fluff—just the
        moves that keep ranking after you stop paying for them.
      </p>
      <div class="hero-actions">
        <a class="hero-cta" href="/blog/">Read the playbook <span aria-hidden="true">→</span></a>
        <a class="hero-ghost" href="/series/">Follow a series</a>
      </div>
      <div class="hero-query" role="img" aria-label="Search query: how to actually rank in 2026">
        <svg class="hero-query-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path>
        </svg>
        <span class="hero-query-q mono">how to actually rank in 2026</span>
        <span class="hero-query-caret" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  {/* ── 2 · PROOF — stat band from the corpus ───────────────────────────── */}
  <section class="proof" aria-label="At a glance">
    <dl class="proof-row">
      <div class="proof-stat">
        <dt class="proof-label mono">results indexed</dt>
        <dd class="proof-num">{allPosts.length}</dd>
      </div>
      <div class="proof-stat">
        <dt class="proof-label mono">running series</dt>
        <dd class="proof-num">{inProgress.length}</dd>
      </div>
      <div class="proof-stat">
        <dt class="proof-label mono">topics covered</dt>
        <dd class="proof-num">{cats.length}</dd>
      </div>
      <div class="proof-stat proof-tag">
        <dt class="proof-label mono">sorted by</dt>
        <dd class="proof-say">what actually works</dd>
      </div>
    </dl>
  </section>

  {/* ── 3 · FEATURE — lead post, full-width ─────────────────────────────── */}
  {lead && (
    <section class="feature" aria-labelledby="feature-h">
      <p class="section-kicker mono">// featured snippet</p>
      <a class="feature-card" href={`/blog/${lead.id}`} data-vertical={leadVertical}>
        <span class="feature-url mono"><span class="serp-dot" aria-hidden="true"></span>{host} › {verticalLabel(leadVertical).toLowerCase()}</span>
        <h2 id="feature-h" class="feature-title">{lead.data.title}</h2>
        <p class="feature-snippet">{lead.data.description}</p>
        <span class="feature-meta mono">
          <time datetime={lead.data.pubDate.toISOString()}>{lead.data.pubDate.toISOString().slice(0, 10)}</time>
          <span aria-hidden="true">·</span><span>{leadRt}</span>
          <span aria-hidden="true">·</span><span class="feature-go">read #1 result →</span>
        </span>
      </a>
    </section>
  )}

  {/* ── 4 · PLAYBOOK — latest as a bold ranked stack (signature) ────────── */}
  <section class="playbook" aria-labelledby="playbook-h">
    <div class="section-head">
      <h2 id="playbook-h" class="section-h">The latest moves</h2>
      <a class="section-all" href="/archive/">all {allPosts.length} results →</a>
    </div>
    <ol class="serp-list">
      {recentPosts.map((p, i) => (
        <li class="serp-row" data-vertical={postVertical(p)}>
          <a class="serp-row-link" href={`/blog/${p.id}`}>
            <span class="serp-rank mono" aria-hidden="true">#{i + 2}</span>
            <span class="serp-body">
              <span class="serp-row-url mono"><span class="serp-dot" aria-hidden="true"></span>{host} › {verticalLabel(postVertical(p)).toLowerCase()}</span>
              <span class="serp-row-title">{p.data.title}</span>
              <span class="serp-row-snippet">{p.data.description}</span>
              <span class="serp-row-meta mono">
                <time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toISOString().slice(0, 10)}</time>
                <span aria-hidden="true">·</span><span>{p.data.readingTime ?? readingTimeFor(p)}</span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  {/* ── 5 · SERIES — running playbooks with progress spines ─────────────── */}
  {inProgress.length > 0 && (
    <section class="series-band" aria-labelledby="series-h">
      <div class="section-head">
        <h2 id="series-h" class="section-h">Playbooks in progress</h2>
        <a class="section-all" href="/series/">browse series →</a>
      </div>
      <ul class="progress-list">
        {inProgress.map((s) => (
          <li class="progress-row">
            <a class="progress-link" href={`/series/${s.slug}/`}>
              <span class="progress-name">{s.name}</span>
              <span class="progress-meta mono">part {s.published} of {s.total}</span>
              <span class="progress-spine-mount">
                <SeriesSpine total={s.total} published={s.published} current={s.current} size="md" />
              </span>
              <span class="progress-ago mono">{ago(s.latest)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* ── 6 · TOPICS — refine chips ───────────────────────────────────────── */}
  {cats.length > 0 && (
    <section class="topics" aria-labelledby="topics-h">
      <h2 id="topics-h" class="section-h">Refine by topic</h2>
      <p class="cats-row">
        {cats.map((c) => (
          <a href={`/categories/${slugifyTag(c.category)}/`} class="cats-chip" data-vertical={verticalFor(c.category)}>
            <span class="cats-name">{c.category}</span>
            <span class="cats-count mono">{c.count}</span>
          </a>
        ))}
      </p>
    </section>
  )}

  {/* ── 7 · CTA — closing conversion band ───────────────────────────────── */}
  <section class="cta-band" aria-labelledby="cta-h">
    <h2 id="cta-h" class="cta-h">Rank for the query your customer is already typing.</h2>
    <div class="cta-actions">
      <a class="hero-cta" href="/blog/">Start with the playbook <span aria-hidden="true">→</span></a>
      <a class="hero-ghost" href="/rss.xml">Subscribe via RSS</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Shared section rhythm */
  .hero, .proof, .feature, .playbook, .series-band, .topics, .cta-band {
    max-width: 1040px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2rem);
  }
  .section-kicker {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin: 0 0 1rem;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .section-h {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0;
    color: var(--ink);
  }
  .section-all {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-mute);
    text-decoration: none;
    white-space: nowrap;
    flex: 0 0 auto;
  }
  .section-all:hover { color: var(--accent); }
  .serp-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--serp-url); flex: 0 0 auto; }

  /* ── 1 · HERO ─────────────────────────────────────────────────────────── */
  .hero { padding-block: clamp(3rem, 10vw, 7rem) clamp(2rem, 5vw, 3.5rem); }
  .hero-inner { max-width: 22ch; }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.25rem;
  }
  .hero-h {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 9vw, 6rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.98;
    margin: 0;
    color: var(--ink);
    max-width: 16ch;
  }
  .hero-h em {
    font-style: normal;
    color: var(--accent);
    -webkit-text-decoration: underline var(--accent) 0.06em;
    text-decoration: underline var(--accent) 0.06em;
    text-underline-offset: 0.1em;
  }
  .hero-sub {
    font-size: clamp(1.05rem, 2.4vw, 1.3rem);
    line-height: 1.55;
    color: var(--ink-mute);
    margin: 1.5rem 0 0;
    max-width: 46ch;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    border-radius: var(--radius-button, 8px);
    background: var(--accent);
    color: var(--color-accent-fg);
    font-family: var(--font-utility, var(--font-mono));
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: transform var(--dur-fast, 120ms) ease, filter var(--dur-fast, 120ms) ease;
  }
  .hero-cta span { transition: transform var(--dur-fast, 120ms) ease; }
  .hero-cta:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .hero-cta:hover span { transform: translateX(4px); }
  .hero-cta:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .hero-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.4rem;
    border-radius: var(--radius-button, 8px);
    border: 1px solid var(--rule-strong);
    color: var(--ink);
    font-family: var(--font-utility, var(--font-mono));
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: border-color var(--dur-fast, 120ms) ease, color var(--dur-fast, 120ms) ease;
  }
  .hero-ghost:hover { border-color: var(--accent); color: var(--accent); }
  .hero-ghost:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .hero-query {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 2.5rem;
    padding: 0.7rem 1.1rem;
    background: color-mix(in oklab, var(--paper-2) 70%, transparent);
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink);
  }
  .hero-query-icon { width: 1.05rem; height: 1.05rem; color: var(--ink-mute); flex: 0 0 auto; }
  .hero-query-q { font-family: var(--font-mono); font-size: 0.95rem; color: var(--ink); }
  .hero-query-caret {
    width: 2px; height: 1.2em; background: var(--accent); margin-left: -0.4rem;
    animation: caret-blink 1.05s steps(1) infinite;
  }
  @keyframes caret-blink { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }

  /* ── 2 · PROOF ────────────────────────────────────────────────────────── */
  .proof {
    padding-block: 1.5rem;
    border-block: 1px solid var(--rule);
  }
  .proof-row {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1rem;
  }
  .proof-stat { margin: 0; }
  .proof-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0;
  }
  .proof-num {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ink);
    margin: 0.35rem 0 0;
  }
  .proof-say {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 3vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--accent);
    margin: 0.35rem 0 0;
  }
  @media (min-width: 720px) { .proof-row { grid-template-columns: repeat(4, 1fr); } }

  /* ── 3 · FEATURE ──────────────────────────────────────────────────────── */
  .feature { padding-block: clamp(2.5rem, 6vw, 4rem) 1.5rem; }
  .feature-card {
    --v: var(--v-personal);
    display: grid;
    gap: 0.6rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--rule);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-card, 12px);
    background: var(--paper-2);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur-fast, 120ms) ease, transform var(--dur-fast, 120ms) ease;
  }
  .feature-card[data-vertical='dev'] { --v: var(--v-dev); }
  .feature-card[data-vertical='finance'] { --v: var(--v-finance); }
  .feature-card[data-vertical='culture'] { --v: var(--v-culture); }
  .feature-card[data-vertical='health'] { --v: var(--v-health); }
  .feature-card:hover { transform: translateY(-2px); }
  .feature-url {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 12px; letter-spacing: 0.01em; color: var(--serp-url);
  }
  .feature-title {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4.5vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin: 0.15rem 0 0;
    color: var(--ink);
    max-width: 20ch;
  }
  .feature-card:hover .feature-title { color: var(--serp-link); }
  .feature-snippet {
    font-size: 1.0625rem; line-height: 1.55; color: var(--ink-mute);
    margin: 0.35rem 0 0; max-width: 62ch;
  }
  .feature-meta {
    display: inline-flex; flex-wrap: wrap; gap: 0.45rem;
    font-size: 11px; letter-spacing: 0.03em; color: var(--ink-mute); margin-top: 0.35rem;
  }
  .feature-go { color: var(--accent); }

  /* ── 4 · PLAYBOOK (SERP ranked stack — signature) ────────────────────── */
  .playbook { padding-block: clamp(2.5rem, 6vw, 4rem); }
  .serp-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.25rem; }
  .serp-row {
    --v: var(--v-personal);
    border-radius: var(--radius-card);
    transition: background var(--dur-fast, 120ms) ease;
  }
  .serp-row[data-vertical='dev'] { --v: var(--v-dev); }
  .serp-row[data-vertical='finance'] { --v: var(--v-finance); }
  .serp-row[data-vertical='culture'] { --v: var(--v-culture); }
  .serp-row[data-vertical='health'] { --v: var(--v-health); }
  .serp-row:hover { background: color-mix(in oklab, var(--paper-2) 75%, transparent); }
  .serp-row-link {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0.5rem 1.15rem;
    align-items: start;
    color: var(--ink);
    text-decoration: none;
    padding: 1.1rem 1rem;
  }
  .serp-rank {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 4vw, 2.1rem);
    font-weight: 500;
    color: var(--v);
    text-align: right;
    padding-right: 0.7rem;
    border-right: 2px solid var(--v);
    line-height: 1;
    padding-top: 0.5rem;
  }
  .serp-body { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .serp-row-url {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 12px; letter-spacing: 0.01em; color: var(--serp-url);
  }
  .serp-row-title {
    font-family: var(--font-sans);
    font-size: clamp(1.1rem, 2.6vw, 1.35rem);
    font-weight: 500;
    color: var(--serp-link);
    line-height: 1.25;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
  }
  .serp-row-link:hover .serp-row-title { text-decoration-color: var(--serp-link); }
  .serp-row-snippet {
    font-size: 0.9375rem; color: var(--ink-mute); line-height: 1.5;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden;
  }
  .serp-row-meta { display: inline-flex; gap: 0.4rem; font-size: 11px; letter-spacing: 0.03em; color: var(--ink-mute); }
  @media (max-width: 480px) {
    .serp-row-link { grid-template-columns: 2.1rem minmax(0, 1fr); gap: 0.35rem 0.7rem; padding-inline: 0.4rem; }
    .serp-rank { padding-right: 0.45rem; }
  }

  /* ── 5 · SERIES ───────────────────────────────────────────────────────── */
  .series-band { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .progress-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .progress-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto auto;
    gap: 1rem;
    align-items: baseline;
    color: var(--ink);
    text-decoration: none;
    padding: 0.75rem 0.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .progress-link:hover { color: var(--accent); }
  .progress-link:hover .progress-meta, .progress-link:hover .progress-ago { color: var(--accent); }
  .progress-name {
    font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; letter-spacing: -0.01em;
    color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .progress-meta, .progress-ago { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em; color: var(--ink-mute); }
  .progress-spine-mount { display: inline-flex; }
  @media (max-width: 640px) {
    .progress-link {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'name ago' 'meta meta' 'spine spine';
      row-gap: 0.3rem;
    }
    .progress-name { grid-area: name; }
    .progress-meta { grid-area: meta; }
    .progress-spine-mount { grid-area: spine; }
    .progress-ago { grid-area: ago; text-align: right; }
  }

  /* ── 6 · TOPICS ───────────────────────────────────────────────────────── */
  .topics { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .topics .section-h { margin-bottom: 1.25rem; }
  .cats-row { margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .cats-chip {
    --v: var(--v-personal);
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-2);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur-fast, 120ms) ease, color var(--dur-fast, 120ms) ease;
